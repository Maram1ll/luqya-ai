# لُقيا AI environment configuration (template)
# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file — it is already git-ignored.

# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=luqya_ai
DB_PORT=3306

# ─── Gemini API ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

# ─── AI semantic matching (hybrid engine) ─────────────────────
# The matching engine always runs the deterministic weighted scorer first.
# This flag only controls whether the Gemini semantic layer re-ranks the
# shortlist on top of it. Set to 0 to fall back to the pure local engine
# without touching any code. With no GEMINI_API_KEY the layer is skipped
# automatically, so the platform keeps working either way.
AI_MATCHING_ENABLED=1

# Where these live is config/matching.php (constants), not here, because they
# are tuning weights rather than secrets or environment switches:
#   MATCH_AI_BLEND_WEIGHT         0.40  how much the model opinion counts
#   MATCH_AI_MAX_PAIRS           5     candidates analysed per single call
#   MATCH_AI_MIN_LOCAL           45    local floor below which AI is not called
#   MATCH_AI_MAX_CALLS_PER_REQUEST 2   hard per-request Gemini call ceiling

# ─── Local development only ──────────────────────────────────
# Set to 1 to print the password-reset link into the PHP error log.
# There is no mailer in this build, so without it the reset flow cannot be
# completed locally. NEVER enable this in production: the raw token is valid
# for 30 minutes and grants a full password change.
LUQYA_EXPOSE_RESET_TOKEN=0

# Set to 1 to show the "quick demo login" panel on login.php, so a reviewer can
# sign in as the seeded security officer without registering an account.
# This flag only CONTROLS WHETHER THE BUTTON IS RENDERED. The button fills the
# two form fields and the form is then submitted normally through
# api/auth.php?action=login, so CSRF, rate limiting and password_verify() all
# still apply. No authentication path is bypassed. Set to 0 in production to
# hide the panel; the seeded demo account itself still exists in the database.
LUQYA_DEMO_LOGIN=1

# Set to 1 to allow setup_db.php to truncate and re-seed an existing database.
ALLOW_DB_RESET=0
