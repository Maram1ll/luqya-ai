# ─── Secrets & environment ───────────────────────────────────
# Local development only. These must NEVER reach a public host.
.env
.env.*
!.env.example

# The real credentials file (holds the actual DB password and Gemini key).
# config/config.example.php is the tracked template and stays committable.
config/config.local.php
config/config.local.*.php
config/*.local.php

# Belt and braces: any secret-looking leftovers anywhere in the tree.
*.local.php.bak
secrets.php
credentials.php

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/

# ─── Runtime / generated ──────────────────────────────────────
# Rate-limit state and other machine-local scratch data.
storage/
# User-uploaded item photos are personal/runtime data and must never be
# committed to a public host — uploads/ stays local.
# One exception: the demo seed photos that database/schema.sql references (and
# the folder-guard files) are shipped to Railway so seeded demo reports show
# their images on the live URL. Anything else under uploads/ remains ignored.
uploads/*
!uploads/.htaccess
!uploads/index.html
!uploads/1789317864_photo_5848143374681050802_y.jpg
!uploads/1789317965_photo_5848143374681050803_y.jpg
!uploads/1789596604_3b98233e.jpg
!uploads/1789598345_fe1e7357.jpeg
!uploads/sec_1789599745_71d935d8.jpeg
!uploads/sec_1789600580_e676ceb7.jpeg
!uploads/1789600728_ea3c9a35.jpeg
!uploads/1789662107_fe0b6bde.jpeg
!uploads/1789662301_ecaa6269.jpeg
# The generated deployment dump (and any archives) contains real rows — bcrypt
# hashes, personal data — so it must never be committed. database.sql is built
# by the deployment step and deliberately stays out of git.
database.sql
database.sql.gz
/database.zip
*.sql.gz
*.zip
# ...though the canonical schema itself is source code and stays tracked.
!database/schema.sql
!database/*.sql

# ─── OS cruft ────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editors / IDEs ──────────────────────────────────────────
.idea/
.vscode/
*.swp
*~

# ─── Local scratch ───────────────────────────────────────────
scratch/
