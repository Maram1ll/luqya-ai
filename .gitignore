# ─── Secrets & environment ───────────────────────────────────
# Local development only. These must NEVER reach a public host.
.env
.env.*
!.env.example

# Deployment secrets file (contains real DB password + Gemini key).
# config/config.example.php IS the tracked template and must stay committable.
config/config.local.php
config/config.local.*.php
config/*.local.php

# Belt-and-braces: any leftover secret-shaped file anywhere in the tree.
*.local.php.bak
secrets.php
credentials.php

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/

# ─── Runtime / generated ──────────────────────────────────────
# Rate-limit state and other machine-local scratch data.
storage/
# User-uploaded item photos (runtime/personal data). Never committed to a
# public host; local uploads/ must also stay just that — local.
# Exception: the demo seed photos referenced by database/schema.sql (plus the
# folder-guard files) ARE shipped to Railway so the seeded demo reports display
# images on the live URL. Everything else under uploads/ stays ignored.
uploads/*
!uploads/.htaccess
!uploads/index.html
!uploads/1789317864_photo_5848143374681050802_y.jpg
!uploads/1789317965_photo_5848143374681050803_y.jpg
!uploads/1789596604_3b98233e.jpg
!uploads/1789598345_fe1e7357.jpeg
!uploads/sec_1789599745_71d935d8.jpeg
!uploads/sec_1789600580_e676ceb7.jpeg
!uploads/1789600728_ea3c9a35.jpeg
!uploads/1789662107_fe0b6bde.jpeg
!uploads/1789662301_ecaa6269.jpeg
# Generated deployment dump + archives must never be committed (they contain
# real rows, including bcrypt hashes and personal data). database.sql is built
# by the deployment step and is intentionally NOT tracked.
database.sql
database.sql.gz
/database.zip
*.sql.gz
*.zip
# ...but the canonical schema IS source code and stays tracked.
!database/schema.sql
!database/*.sql

# ─── OS cruft ────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editors / IDEs ──────────────────────────────────────────
.idea/
.vscode/
*.swp
*~

# ─── Local scratch ───────────────────────────────────────────
scratch/
