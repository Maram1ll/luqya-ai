# ============================================================
# لُقيا AI — config/ directory
# This directory holds the application's include files.
#
# PHP `require` reads them from the filesystem, which is unaffected
# by this rule, so the app keeps working. What is blocked is any
# HTTP request for them, so nobody can read their source through
# the browser or a misconfigured handler.
#
# Deny everything here. config.local.php (real secrets) lives in
# this directory and gets the same protection.
# ============================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback, in case mod_authz_core is unavailable.
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes